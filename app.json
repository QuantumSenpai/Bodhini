{
  "expo": {
    "name": "Bodhini",
    "slug": "bodhini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bodhini-icon-1024.png",
    "scheme": "bodhini",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6148",
        "foregroundImage": "./assets/images/bodhini-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Bodhini",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/bodhini-mark-green.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F1",
          "image": "./assets/images/bodhini-mark-green.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B0B0B",
            "image": "./assets/images/bodhini-mark-white.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bodhini to use your camera to scan documents.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bodhini to choose document images from your photo library.",
          "cameraPermission": "Allow Bodhini to take a photo of your document."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3db3552b-ec12-43f1-be34-2c75b5880279"
      }
    },
    "owner": "kyzenns-team"
  }
}
